{
  // Shared by the console and Blazor. Keep secrets in appsettings.local.json on the client VM.
  "DocumentIntelligence": {
    // Use the resource's HTTPS endpoint and actual tier. Setting Tier never changes the Azure resource.
    "Endpoint": "", "ApiKey": "", "ApiVersion": "2024-11-30", "ModelId": "prebuilt-invoice",
    // CustomModelId refers to an already trained model in the same resource. Blank Locale lets Azure infer language.
    // Explicit Pages on S0 (for example "1-3,5") marks the invoice incomplete; blank means all pages.
    "CustomModelId": "", "Tier": "F0", "Locale": "", "Pages": "",
    "QueryFields": ["VendorName","VendorAddress","VendorTaxId","CustomerName","CustomerAddress","InvoiceId","PurchaseOrder","InvoiceDate","DueDate","SubTotal","TotalTax","InvoiceTotal","AmountDue","Currency","PaymentTerms"],
    "TimeoutSeconds": 300, "MaxRetries": 5, "PollIntervalMilliseconds": 2000
  },
  "Batch": {
    "InputDirectory": "invoices", "FilePattern": "*.pdf", "Recursive": true, "MaxDocuments": 1,
    "Concurrency": 2, "RequestsPerSecond": 2,
    // Hard budget includes every analyze submission and fallback, but excludes polling.
    "MaxAnalyzeRequests": 100, "SkipPreviouslyCompleted": true, "ContinueOnFileError": true
  },
  "Pipeline": {
    "TargetFields": ["VendorName","VendorAddress","VendorTaxId","CustomerName","CustomerAddress","InvoiceId","PurchaseOrder","InvoiceDate","DueDate","SubTotal","TotalTax","InvoiceTotal","AmountDue","Currency","PaymentTerms"],
    // Optional missing fields are reported; they do not independently block acceptance.
    "RequiredFields": ["VendorName","InvoiceId","InvoiceDate","InvoiceTotal","Currency"],
    // Policy threshold, not a claimed accuracy. Overrides use exact names: { "InvoiceTotal": 0.995 }.
    "AcceptanceConfidence": 0.98, "FieldThresholds": {},
    // Query fields and high-resolution OCR can incur extra charges. F0 skips paid passes.
    "AllowPaidFeatures": false, "QueryMode": "Fallback", "HighResolutionFallback": true,
    // Re-rendering can lose useful text. Enable only after evaluating representative samples.
    "RasterFallback": false, "RasterGrayscale": false, "RasterDpi": 300,
    // Strategy order: Original, QueryFields, HighResolution, Raster, CustomModel. Disable alternatives or
    // raise MaxPasses (maximum 5) to leave room for a later strategy. Every submitted pass can consume quota.
    "MaxRasterPages": 10, "MaxRasterPixels": 25000000, "MaxPasses": 3,
    "MinimumOcrConfidence": 0.85, "AmountTolerance": 0.02, "CheckTotals": true, "CheckDateOrder": true
  },
  "Storage": { "DatabasePath": "data/invoices.db", "ExportDirectory": "exports", "ArtifactDirectory": "data/artifacts" }
}
